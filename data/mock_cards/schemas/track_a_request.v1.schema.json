{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

"$id": "track_a_request.v1.schema.json",
"title": "Requête Track A - Lawyer Track - v1",
"description": "Contrat v1 d'entrée de DS4 pour l'analyse structurée d'un dossier juridique.",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "case_id",
    "lang",
    "parties",
    "events",
    "claims",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "track_a.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lang": {
      "enum": [
        "fr",
        "ar"
      ]
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "party_id",
          "name",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "party_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "date",
          "description",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date_precision": {
            "type": "string",
            "enum": [
              "exact",
              "unknown"
            ]
          },
          "date_reason": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "\\S"
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "date": {
                  "type": "null"
                }
              },
              "required": [
                "date"
              ]
            },
            "then": {
              "required": [
                "date_precision",
                "date_reason"
              ],
              "properties": {
                "date_precision": {
                  "const": "unknown"
                },
                "date_reason": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "else": {
              "properties": {
                "date_precision": {
                  "const": "exact"
                }
              }
            }
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "party_id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "party_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "legal_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "type",
          "description",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "document_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "subject_id",
          "evidence_id",
          "document_id",
          "field_name",
          "value",
          "confidence",
          "user_confirmed",
          "citation",
          "warnings"
        ],
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "field_name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "user_confirmed": {
            "type": "boolean"
          },
          "citation": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "citation_id",
                  "document_id",
                  "page",
                  "exact_excerpt"
                ],
                "additionalProperties": false,
                "properties": {
                  "citation_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "document_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "exact_excerpt": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "legal_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "article_id",
          "reference",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "article_id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "citation": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "citation_id",
                  "document",
                  "page",
                  "exact_excerpt"
                ],
                "additionalProperties": false,
                "properties": {
                  "citation_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "document": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "exact_excerpt": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "validity_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "version_group": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "applicable_at_reference_date": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          {
            "required": [
              "excerpt"
            ],
            "properties": {
              "excerpt": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        ]
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "missing_id",
          "field_name",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "missing_id": {
            "type": "string",
            "minLength": 1
          },
          "field_name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "related_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contradiction_id",
          "description",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "contradiction_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reference_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Date de r?f?rence explicite du dossier. Null si inconnue. Ne jamais la d?duire automatiquement."
    }
  }
}
