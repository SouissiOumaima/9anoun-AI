{
  "$defs": {
    "DocumentAnalysis": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "enum": [
            "fiche_de_paie",
            "facture",
            "contrat_travail",
            "convention_collective",
            "piece_dossier",
            "inconnu"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "document_type_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Document Type Confidence",
          "type": "number"
        },
        "languages": {
          "items": {
            "enum": [
              "ar",
              "fr"
            ],
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "page_count": {
          "title": "Page Count",
          "type": "integer"
        },
        "complete": {
          "description": "False si au moins une valeur présente sur le document n'a pas pu être lue (zone_illisible ou valeur_incoherente). Un champ absent du document ne rend pas le résultat incomplet.",
          "title": "Complete",
          "type": "boolean"
        },
        "summary": {
          "description": "Résumé factuel, sans interprétation juridique.",
          "title": "Summary",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/ExtractedField"
          },
          "title": "Fields",
          "type": "object"
        },
        "pay_lines": {
          "items": {
            "$ref": "#/$defs/PayLine"
          },
          "title": "Pay Lines",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/ExtractedTable"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "document_type",
        "document_type_confidence",
        "languages",
        "page_count",
        "complete",
        "summary",
        "fields"
      ],
      "title": "DocumentAnalysis",
      "type": "object"
    },
    "DocumentCitation": {
      "additionalProperties": false,
      "description": "Source d'une valeur lue dans un document de carte (proposée pour common.v1).",
      "properties": {
        "citation_id": {
          "minLength": 1,
          "title": "Citation Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "[x0, y0, x1, y1] en points PDF, origine en haut à gauche.",
          "title": "Bbox"
        },
        "excerpt": {
          "description": "Texte exact lu à cet endroit, pour la vérification DS6.",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "document_id",
        "page",
        "bbox",
        "excerpt"
      ],
      "title": "DocumentCitation",
      "type": "object"
    },
    "Erreur": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "message_fr": {
          "minLength": 1,
          "title": "Message Fr",
          "type": "string"
        },
        "message_ar": {
          "minLength": 1,
          "title": "Message Ar",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message_fr",
        "message_ar"
      ],
      "title": "Erreur",
      "type": "object"
    },
    "ExtractedField": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "value_type": {
          "enum": [
            "montant",
            "date",
            "entier",
            "enum",
            "texte"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "confidence": {
          "description": "Sans objet (0.0) quand le champ est absent.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "citation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Citation Id"
        },
        "unreadable_reason": {
          "anyOf": [
            {
              "enum": [
                "zone_illisible",
                "valeur_incoherente",
                "absent_du_document"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreadable Reason"
        },
        "currency": {
          "anyOf": [
            {
              "const": "TND",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "value",
        "value_type",
        "confidence",
        "citation_id"
      ],
      "title": "ExtractedField",
      "type": "object"
    },
    "ExtractedTable": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "n_rows": {
          "title": "N Rows",
          "type": "integer"
        },
        "n_cols": {
          "title": "N Cols",
          "type": "integer"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "table_id",
        "title",
        "citation_id",
        "n_rows",
        "n_cols",
        "cells"
      ],
      "title": "ExtractedTable",
      "type": "object"
    },
    "GradeInfo": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "title": "Grade",
          "type": "integer"
        },
        "duration_years": {
          "title": "Duration Years",
          "type": "integer"
        },
        "seniority": {
          "title": "Seniority",
          "type": "string"
        }
      },
      "required": [
        "grade",
        "duration_years",
        "seniority"
      ],
      "title": "GradeInfo",
      "type": "object"
    },
    "PayLine": {
      "additionalProperties": false,
      "description": "Ligne de prime ou d'indemnité imprimée sur la fiche de paie, telle quelle.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+\\.[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "citation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Citation Id"
        },
        "unreadable_reason": {
          "anyOf": [
            {
              "enum": [
                "zone_illisible",
                "valeur_incoherente",
                "absent_du_document"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreadable Reason"
        }
      },
      "required": [
        "label",
        "amount",
        "confidence",
        "citation_id"
      ],
      "title": "PayLine",
      "type": "object"
    },
    "Refus": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "SOURCE_MANQUANTE",
            "HORS_SCOPE",
            "PARAM_INVALIDE",
            "ACCES_REFUSE"
          ],
          "title": "Code",
          "type": "string"
        },
        "message_fr": {
          "minLength": 1,
          "title": "Message Fr",
          "type": "string"
        },
        "message_ar": {
          "minLength": 1,
          "title": "Message Ar",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message_fr",
        "message_ar"
      ],
      "title": "Refus",
      "type": "object"
    },
    "ResponseMeta": {
      "additionalProperties": false,
      "properties": {
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "processing_ms": {
          "title": "Processing Ms",
          "type": "integer"
        }
      },
      "required": [
        "pipeline_version",
        "processing_ms"
      ],
      "title": "ResponseMeta",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "title": "Col",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "row",
        "col",
        "value",
        "confidence"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "WageGrid": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "sector_ar": {
          "title": "Sector Ar",
          "type": "string"
        },
        "sector_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Code DS2 du secteur (table src/shared/sectors, D30), seulement si le libellé arabe ou le titre de la convention correspond exactement ; sinon null (jamais déduit d'un alias).",
          "title": "Sector Code"
        },
        "effective_date": {
          "description": "Date d'effet ISO (AAAA-MM-JJ).",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Effective Date",
          "type": "string"
        },
        "unit": {
          "const": "TND/mois",
          "title": "Unit",
          "type": "string"
        },
        "legal_basis": {
          "title": "Legal Basis",
          "type": "string"
        },
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "complete": {
          "description": "False si toutes les cases n'ont pas été extraites.",
          "title": "Complete",
          "type": "boolean"
        },
        "grades": {
          "items": {
            "$ref": "#/$defs/GradeInfo"
          },
          "title": "Grades",
          "type": "array"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/WageValue"
          },
          "title": "Values",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "title",
        "sector_ar",
        "effective_date",
        "unit",
        "legal_basis",
        "citation_id",
        "complete",
        "grades",
        "values"
      ],
      "title": "WageGrid",
      "type": "object"
    },
    "WageValue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "integer"
        },
        "grade": {
          "title": "Grade",
          "type": "integer"
        },
        "amount": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+\\.[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "unreadable_reason": {
          "anyOf": [
            {
              "enum": [
                "zone_illisible",
                "valeur_incoherente",
                "absent_du_document"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreadable Reason"
        }
      },
      "required": [
        "category",
        "grade",
        "amount",
        "confidence"
      ],
      "title": "WageValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "ds3.v2",
      "default": "ds3.v2",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Id"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Absent de la réponse JSON quand il n'y a pas de dossier.",
      "title": "Case Id"
    },
    "status": {
      "enum": [
        "ok",
        "refus",
        "erreur"
      ],
      "title": "Status",
      "type": "string"
    },
    "refus": {
      "anyOf": [
        {
          "$ref": "#/$defs/Refus"
        },
        {
          "type": "null"
        }
      ]
    },
    "erreur": {
      "anyOf": [
        {
          "$ref": "#/$defs/Erreur"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Présent seulement si status = erreur."
    },
    "computed_by": {
      "enum": [
        "document_intelligence.mock",
        "document_intelligence.service"
      ],
      "title": "Computed By",
      "type": "string"
    },
    "mode": {
      "enum": [
        "mock",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "card_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Card Id"
    },
    "document_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Document Id"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/DocumentCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentAnalysis"
        },
        {
          "$ref": "#/$defs/WageGrid"
        },
        {
          "type": "null"
        }
      ],
      "title": "Result"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "ds3_code": {
      "anyOf": [
        {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_OPERATION",
            "UNSUPPORTED_FORMAT",
            "FILE_EMPTY_OR_CORRUPTED",
            "FILE_TOO_LARGE",
            "ACCESS_DENIED",
            "UNREADABLE_DOCUMENT",
            "NO_TABLE_FOUND",
            "TIMEOUT",
            "INTERNAL_ERROR"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Code DS3 détaillé, pour le diagnostic.",
      "title": "Ds3 Code"
    },
    "retryable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Présent seulement si status = erreur.",
      "title": "Retryable"
    },
    "meta": {
      "$ref": "#/$defs/ResponseMeta"
    }
  },
  "required": [
    "request_id",
    "status",
    "refus",
    "computed_by",
    "mode",
    "operation",
    "card_id",
    "document_id",
    "citations",
    "result",
    "meta"
  ],
  "title": "DS3Response",
  "type": "object"
}
