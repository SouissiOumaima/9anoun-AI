{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator_case_card.v0.schema.json",
  "title": "Case Card structurée DS1 v0",
  "description": "v0 - proposition DS1, à valider avec DS3 et DS4. Carte de dossier factuelle : aucune qualification ou conclusion juridique n'est autorisée dans cette carte.",
  "type": "object",
  "required": ["card_id", "organization_id", "card_type", "data"],
  "additionalProperties": false,
  "properties": {
    "card_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "card_type": {"const": "case"},
    "data": {
      "type": "object",
      "required": ["title", "jurisdiction", "documents", "parties", "events", "claims", "evidence"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "jurisdiction": {"const": "TN"},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
        "parties": {"type": "array", "items": {"$ref": "#/$defs/party"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["document_id", "label", "file_name", "mime_type", "storage_ref"],
      "additionalProperties": false,
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "file_name": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "storage_ref": {"type": "string", "minLength": 1}
      }
    },
    "party": {
      "type": "object",
      "required": ["party_id", "name", "role", "party_type"],
      "additionalProperties": false,
      "properties": {
        "party_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "party_type": {"enum": ["physical_person", "legal_entity", "unknown"]}
      }
    },
    "event": {
      "type": "object",
      "required": ["event_id", "date", "date_precision", "description", "evidence_ids", "confidence"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"], "format": "date"},
        "date_precision": {"enum": ["exact", "month", "year", "unknown"]},
        "date_reason": {"type": ["string", "null"], "pattern": "\\S"},
        "description": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "party_id", "text", "event_ids", "evidence_ids", "confidence"],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "party_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "claim_type": {"type": ["string", "null"]},
        "event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "document_id", "type", "description", "citation", "confidence", "supports"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "citation": {"$ref": "#/$defs/citation"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "supports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact_reference"}}
      }
    },
    "citation": {
      "type": "object",
      "required": ["citation_id", "page", "excerpt"],
      "additionalProperties": false,
      "properties": {
        "citation_id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "fact_reference": {
      "type": "object",
      "required": ["fact_type", "fact_id"],
      "additionalProperties": false,
      "properties": {
        "fact_type": {"enum": ["event", "claim"]},
        "fact_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
